// 汉语关键字当【属性名】用 —— 与英文 obj.if 同构，必须照旧合法。
//
// 这是「关键字成为保留字」的边界，值得单独钉住：
//   保留的是【标识符位置】，不是【属性名位置】。
//   ✗ 常量 对象 = 1        编不过（对象 是 object 的译名，占了标识符位）
//   ✓ 常量 甲 = { 对象: 1 }  合法（对象 在属性名位）
//   ✓ 甲.对象              合法（点号后允许关键字）
//   ✓ 甲["对象"]           合法（字符串键）
//
// 判定要求：编译退出码 0，且 node 真跑输出 10 与 本地:20。

常量 甲 = { 对象: 1, 如果: 2, 函数: 3, 名字: 4 }
console.log(甲.对象 + 甲.如果 + 甲.函数 + 甲.名字)

接口 配置 {
  对象: 字符串
  返回: 数字
}

常量 乙: 配置 = { 对象: "本地", 返回: 20 }
console.log(乙.对象 + ":" + 乙.返回)
